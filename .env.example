# GMAOS / EAOS strict zero-spend mode
GMAOS_MODE=strict_zero_spend
GMAOS_AUDIT_LOG=/data/logs/audit.jsonl
GMAOS_APPROVAL_DB=/data/approvals.json
GMAOS_VECTOR_CACHE=/data/vector_cache.sqlite3
GMAOS_LOCAL_MODEL_ENDPOINT=http://ollama:11434/v1/chat/completions
GMAOS_LOCAL_MODEL_ENABLED=false
GMAOS_PAID_ADAPTERS_ENABLED=false
GMAOS_MAX_COST_USD=0
GMAOS_SEMANTIC_MATCH_FLOOR=0.96
GMAOS_EMBEDDING_DIM=384

# Production domain
PRIMARY_DOMAIN=alreadyherellc.com
PUBLIC_SITE_URL=https://alreadyherellc.com
COMMAND_CENTER_URL=https://app.alreadyherellc.com
API_BASE_URL=https://api.alreadyherellc.com
STATUS_URL=https://status.alreadyherellc.com
N8N_PUBLIC_URL=https://n8n.alreadyherellc.com
N8N_HOST=n8n.alreadyherellc.com
N8N_PROTOCOL=https
ACME_EMAIL=alreadyherellc@gmail.com

# Server-side only. Replace after copying to .env on the server.
POSTGRES_DB=gmaos
POSTGRES_USER=gmaos
POSTGRES_PASSWORD=change-me-server-side
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-server-side

# ── ASI Engine ────────────────────────────────────────────────────────────────
# Auto-deploy switch: false = patches saved for review, true = live hot-swap
ASI_AUTO_DEPLOY=false
CLUSTER_SECRET=REPLACE_WITH_cluster_secret
# GEMINI_API_KEY already listed above (reused by ASI engine)
